# ==============================================================================
# AGORA VOICE AI ASSISTANT - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AGORA CREDENTIALS (Required)
# ------------------------------------------------------------------------------
# Agora Console (https://console.agora.io) -> Project Management -> Project Detail
NEXT_PUBLIC_AGORA_APP_ID=
# Server-side App Certificate (Keep secret, never prefix with NEXT_PUBLIC_)
NEXT_AGORA_APP_CERTIFICATE=

# ------------------------------------------------------------------------------
# 2. CUSTOM LLM / CHAT COMPLETIONS (Optional / Custom LLM Route)
# ------------------------------------------------------------------------------
# OpenAI or compatible LLM API Key (used for /api/chat/completions endpoint)
NEXT_LLM_API_KEY=
# LLM Base URL or endpoint (e.g., https://api.openai.com/v1/chat/completions)
NEXT_LLM_URL=

# ------------------------------------------------------------------------------
# 3. LIVE KNOWLEDGE SEARCH PROVIDERS (Optional for Web Grounding)
# ------------------------------------------------------------------------------
# Tavily Search API Key (https://tavily.com) - for real-time web search
TAVILY_API_KEY=
# Serper Google Search API Key (https://serper.dev) - alternative web search
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPTIONAL BYOK VENDOR KEYS (If not using Agora Reseller defaults)
# ------------------------------------------------------------------------------
# Deepgram API Key (if using custom Deepgram BYOK)
NEXT_DEEPGRAM_API_KEY=
# ElevenLabs API Key & Voice ID (if using custom ElevenLabs TTS)
NEXT_ELEVENLABS_API_KEY=
NEXT_ELEVENLABS_VOICE_ID=
